__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Env
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Streamlit
.streamlit/ secrets.toml

# IDE
.vscode
.idea
*.swp
.DS_Store

# Local App Data
data/

# Legacy Code (Ignored as per user request to ensure no PII leak)
legacy/
# Legacy MF analytics script kept at root for reference (not first-party product code)
/mf.py
# Runtime data folder (financial PII — never commit)
storage/
# ...but the storage-shape models package and its tests are source code.
!backend/app/models/storage/
!tests/models/storage/

# Frontend
frontend/node_modules/
frontend/dist/
# Node deps at any level (a root install would otherwise stage thousands of files)
node_modules/

.superpowers/

# Demo ledger is a regenerated build artifact (see scripts/build_demo.py)
demo/data/
# Fictional MF order-history demo dataset (regenerated by scripts/build_mf_demo.py)
demo/MFOrderHistory/

# Claude Code local (machine-specific) settings — never commit
.claude/settings.local.json

# Per-commit review / research scratch notes — durable on disk, never tracked.
# The ** form matters: archiving a review under docs/_archive/ used to escape the
# top-level pattern, which left 41 of them untracked-but-unignored.
docs/**/REVIEW-*.md
docs/**/CRITIQ-*.md
docs/research-*.md
# Personal working note (marked "DON'T COMMIT") — kept on disk, never tracked
/TODO-backend-refactor.md
# Local real-PII denylist for the demo-build guard — never commit
scripts/.pii-denylist.txt
# Unlocked statement copies — never commit
*-unlocked.pdf

# git worktrees for parallel lanes
.worktrees/

# Implementation plans are scratch for an execution run, not a deliverable:
# they go stale the moment the code lands, and a stale plan read as current is
# worse than no plan. The durable records are the spec (docs/superpowers/specs/)
# and the review. Plans were tracked until 2026-10-24; untracked from here.
# The ** form matters, same trap as the REVIEW-* rule above: archiving a plan
# under docs/_archive/superpowers/plans/ used to escape a path-anchored rule.
docs/**/plans/

# docs/ is for usage docs only. Specs, plans, designs, status notes, reviews,
# research and mockups are working scratch and are never committed.
docs/*
!docs/product/
!docs/usage.html
!docs/api-reference.html
!docs/screenshots/
!docs/varaha-icon.svg
!docs/streams/
docs/streams/*
!docs/streams/README.md
!docs/superpowers/
docs/superpowers/*
!docs/superpowers/spendsift-repo-rules.md
